Процедура ОбработкаПроведения(Отказ, Режим)

    // Регистр продаж оставляем для отчета
    Движения.ПродажиТовараЗадача_5.Записывать = Истина;

    // Регистр остатков используем для списания по срокам годности
    Движения.ОстаткиТовараЗадача_5.Записывать = Истина;

    Для Каждого ТекСтрокаТовары Из Товары Цикл

        // 1. Записываем продажу в регистр продаж
        ДвижениеПродажи = Движения.ПродажиТовараЗадача_5.Добавить();

        ДвижениеПродажи.Период = Дата;
        ДвижениеПродажи.Номенклатура = ТекСтрокаТовары.Номенклатура;
        ДвижениеПродажи.Количество = ТекСтрокаТовары.Количество;
        ДвижениеПродажи.Сумма = ТекСтрокаТовары.Сумма;

        // 2. Сколько товара нужно списать
        КоличествоСписать = ТекСтрокаТовары.Количество;

        // 3. Получаем остатки товара по срокам годности
        Запрос = Новый Запрос;

        Запрос.Текст =
        "ВЫБРАТЬ
        |	ОстаткиТовараЗадача_5Остатки.СрокГодности КАК СрокГодности,
        |	ОстаткиТовараЗадача_5Остатки.КоличествоОстаток КАК КоличествоОстаток
        |ИЗ
        |	РегистрНакопления.ОстаткиТовараЗадача_5.Остатки(&Момент, Номенклатура = &Номенклатура) КАК ОстаткиТовараЗадача_5Остатки
        |
        |УПОРЯДОЧИТЬ ПО
        |	СрокГодности";

        Запрос.УстановитьПараметр("Момент", Дата);
        Запрос.УстановитьПараметр(
            "Номенклатура",
            ТекСтрокаТовары.Номенклатура
        );

        //@skip-check query-in-loop
        ВыборкаОстатков = Запрос.Выполнить().Выбрать();

        // 4. Перебираем партии от ближайшего срока годности к дальнему
        Пока ВыборкаОстатков.Следующий()
            И КоличествоСписать > 0 Цикл

            // Определяем, сколько взять из текущей партии
            Если ВыборкаОстатков.КоличествоОстаток
                >= КоличествоСписать Тогда

                КоличествоКСписанию = КоличествоСписать;

            Иначе

                КоличествоКСписанию =
                    ВыборкаОстатков.КоличествоОстаток;

            КонецЕсли;

            // 5. Создаем расходное движение по конкретной партии
            ДвижениеРасход = Движения.ОстаткиТовараЗадача_5.Добавить();

            ДвижениеРасход.ВидДвижения =
                ВидДвиженияНакопления.Расход;

            ДвижениеРасход.Период = Дата;

            ДвижениеРасход.Номенклатура =
                ТекСтрокаТовары.Номенклатура;

            // Срок берём из текущей строки остатков!
            ДвижениеРасход.СрокГодности =
                ВыборкаОстатков.СрокГодности;

            ДвижениеРасход.Количество = КоличествоКСписанию;

            // Уменьшаем количество, которое ещё нужно списать
            КоличествоСписать =
                КоличествоСписать - КоличествоКСписанию;

        КонецЦикла;

        // 6. Если товара не хватило — запрещаем проведение
        Если КоличествоСписать > 0 Тогда

            Отказ = Истина;

            Сообщить("Недостаточно товара: " + Строка(ТекСтрокаТовары.Номенклатура));

            Возврат;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры